<section class="group-settings-page" aria-labelledby="settings-title">
  <%= render "groups/navigation", group: @group %>
  <header class="ui-page-header"><div><p class="eyebrow"><%= @group.name %></p><h1 id="settings-title" class="ui-page-header__title">Configurações</h1><p class="ui-page-header__description">Membros, convites, ownership e arquivamento seguem as permissões existentes do grupo.</p></div></header>
  <section class="settings-section" aria-labelledby="members-title"><h2 id="members-title">Membros</h2><ul class="audit-list"><% @memberships.each do |membership| %><li><strong><%= membership.user.email %></strong> <%= membership.role == "owner" ? "Owner" : "Membro" %>; <%= membership.active? ? "ativo" : "inativo" %>.
    <% unless @group.archived_at? %><div class="invitation-card__actions">
      <% if policy(membership).reactivate? && membership.inactive? %><%= button_to "Reativar", "/groups/#{@group.id}/memberships/#{membership.id}/reactivate", class: "ui-button ui-button--secondary" %><% end %>
      <% if policy(membership).transfer_ownership? && membership.active? && membership.user_id != current_user.id %><%= button_to "Transferir ownership", "/groups/#{@group.id}/memberships/#{membership.id}/transfer_ownership", class: "ui-button ui-button--secondary", data: { turbo_confirm: "Transferir ownership para #{membership.user.email}?" } %><% end %>
      <% if policy(membership).deactivate? && membership.active? %>
        <% reason = @membership_deactivation_reasons.fetch(membership.id, nil) %>
        <% if reason %><%= button_tag(membership.user_id == current_user.id ? "Sair do grupo" : "Inativar membro", type: "button", disabled: true, class: "ui-button ui-button--secondary") %><span class="settings-action-note"><%= reason == "último owner ativo não pode sair" ? "Transfira o ownership antes de sair." : reason %></span><% else %><%= button_to membership.user_id == current_user.id ? "Sair do grupo" : "Inativar membro", "/groups/#{@group.id}/memberships/#{membership.id}/deactivate", class: "ui-button ui-button--secondary", data: { turbo_confirm: membership.user_id == current_user.id ? "Sair deste grupo?" : "Inativar #{membership.user.email}?" } %><% end %>
      <% end %>
    </div><% end %>
  </li><% end %></ul></section>
  <% if policy(@group).update? && @memberships.active.many? %>
    <section class="settings-section" aria-labelledby="order-title">
      <h2 id="order-title">Ordenar membros</h2>
      <p>Escolha um membro para cada posição e salve a ordem completa.</p>
      <%= form_with url: group_memberships_order_path(@group), scope: :membership, method: :patch, class: "group-create__form" do |form| %>
        <% @memberships.select(&:active?).each_with_index do |membership, index| %>
          <div><%= form.label "ids_#{index}", "Posição #{index + 1}" %><%= select_tag "membership[ids][]", options_for_select(@memberships.select(&:active?).map { |candidate| [ candidate.user.email, candidate.id ] }, membership.id), id: "membership_ids_#{index}", class: "ui-field__control" %></div>
        <% end %>
        <%= form.submit "Salvar ordem", class: "ui-button ui-button--secondary" %>
      <% end %>
    </section>
  <% end %>
  <% if policy(@group).invite? && !@group.archived_at? %>
    <section class="settings-section" aria-labelledby="invitations-title">
      <h2 id="invitations-title">Convidar pessoa</h2>
      <%= form_with url: group_invitations_path(@group), scope: :invitation, class: "group-create__form" do |form| %>
        <%= form.label :email, "E-mail", class: "sr-only" %><%= form.email_field :email, required: true, class: "ui-field__control", placeholder: "pessoa@exemplo.com" %><%= form.submit "Enviar convite", class: "ui-button ui-button--primary" %>
      <% end %>
      <% if @pending_invitations.any? %><ul class="audit-list"><% @pending_invitations.each do |invitation| %><li><%= invitation.invited_user.email %><%= button_to "Revogar convite", "/groups/#{@group.id}/invitations/#{invitation.id}/revoke", class: "ui-button ui-button--secondary" %></li><% end %></ul><% else %><p>Nenhum convite pendente.</p><% end %>
    </section>
  <% end %>
  <% if policy(@group).update? && !@group.archived_at? %><section class="settings-section" aria-labelledby="group-name-title"><h2 id="group-name-title">Nome do grupo</h2><%= form_with model: @group, class: "group-create__form" do |form| %><%= form.label :name, "Nome", class: "sr-only" %><%= form.text_field :name, required: true, class: "ui-field__control" %><%= form.submit "Salvar nome", class: "ui-button ui-button--primary" %><% end %></section><% end %>
  <% if policy(@group).update? %><section class="settings-section" aria-labelledby="archive-title"><h2 id="archive-title">Arquivamento</h2><% if @group.archived_at? %><%= button_to "Restaurar grupo", group_restore_path(@group), method: :post, class: "ui-button ui-button--primary" %><% else %><%= button_to "Arquivar grupo", group_archive_path(@group), method: :post, class: "ui-button ui-button--secondary", data: { turbo_confirm: "Arquivar este grupo?" } %><% end %></section><% end %>
</section>
