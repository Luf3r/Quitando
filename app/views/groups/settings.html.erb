<section class="group-settings-page group-reading-column" aria-labelledby="settings-title">
  <%= render "groups/navigation", group: @group %>
  <header class="ui-page-header">
    <div>
      <p class="eyebrow"><%= @group.name %></p>
      <h1 id="settings-title" class="ui-page-header__title">Configurações</h1>
      <p class="ui-page-header__description">Nome, convites, membros e arquivamento seguem as permissões existentes do grupo.</p>
    </div>
  </header>

  <% if policy(@group).update? && !@group.archived_at? %>
    <section class="settings-section" aria-labelledby="group-name-title">
      <h2 id="group-name-title">Nome do grupo</h2>
      <%= form_with model: @group, class: "settings-inline-form" do |form| %>
        <%= render FieldComponent.new(label: "Nome", name: "group[name]", value: @group.name, options: { required: true }) %>
        <%= form.submit "Salvar nome", class: "ui-button ui-button--primary" %>
      <% end %>
    </section>
  <% end %>

  <% if policy(@group).invite? %>
    <section class="settings-section" aria-labelledby="invitations-title">
      <h2 id="invitations-title">Histórico de convites enviados</h2>
      <% unless @group.archived_at? %>
        <section class="settings-subsection" aria-labelledby="invite-person-title">
          <h3 id="invite-person-title">Convidar pessoa</h3>
          <%= form_with url: group_invitations_path(@group), scope: :invitation, class: "settings-inline-form" do |form| %>
            <%= render FieldComponent.new(label: "E-mail", name: "invitation[email]", type: :email, options: { required: true, placeholder: "pessoa@exemplo.com" }) %>
            <%= form.submit "Enviar convite", class: "ui-button ui-button--primary" %>
          <% end %>
        </section>
      <% end %>

      <section class="settings-subsection" aria-labelledby="pending-invitations-title">
        <h3 id="pending-invitations-title">Pendentes</h3>
        <% if @sent_pending_page.entries.any? %>
          <ul class="settings-record-list">
            <% @sent_pending_page.entries.each do |invitation| %>
              <li class="settings-record settings-invitation">
                <dl class="settings-record__fields">
                  <div><dt>E-mail</dt><dd><%= invitation.invited_user.email %></dd></div>
                  <div><dt>Estado</dt><dd><%= render StatusBadgeComponent.new(status: invitation.status) %></dd></div>
                  <div><dt>Enviado em</dt><dd><time datetime="<%= invitation.created_at.iso8601 %>"><%= l(invitation.created_at, format: :short) %></time></dd></div>
                </dl>
                <% unless @group.archived_at? %>
                  <div class="settings-record__actions"><%= button_to "Revogar convite", "/groups/#{@group.id}/invitations/#{invitation.id}/revoke", class: "ui-button ui-button--danger ui-button--compact" %></div>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="section-empty">Nenhum convite pendente.</p>
        <% end %>
        <% if @sent_pending_page.total_pages > 1 %>
          <nav class="pagination" aria-label="Paginação dos convites enviados pendentes">
            <% if @sent_pending_page.number > 1 %><%= link_to "Anterior", group_settings_path(@group, pending_page: @sent_pending_page.number - 1, closed_page: @sent_terminal_page.number) %><% end %>
            <span>Página <%= @sent_pending_page.number %> de <%= @sent_pending_page.total_pages %></span>
            <% if @sent_pending_page.number < @sent_pending_page.total_pages %><%= link_to "Próxima", group_settings_path(@group, pending_page: @sent_pending_page.number + 1, closed_page: @sent_terminal_page.number) %><% end %>
          </nav>
        <% end %>
      </section>

      <details id="closed-invitations-history" class="settings-history" <%= "open" if @closed_invitation_history_open %>>
        <summary>Histórico de convites encerrados</summary>
        <% if @sent_terminal_page.entries.any? %>
          <ul class="settings-record-list">
            <% @sent_terminal_page.entries.each do |invitation| %>
              <% terminal_at = invitation_terminal_at(invitation) %>
              <li class="settings-record settings-invitation">
                <dl class="settings-record__fields">
                  <div><dt>E-mail</dt><dd><%= invitation.invited_user.email %></dd></div>
                  <div><dt>Estado</dt><dd><%= render StatusBadgeComponent.new(status: invitation.status) %></dd></div>
                  <div><dt>Encerrado em</dt><dd><time datetime="<%= terminal_at.iso8601 %>"><%= l(terminal_at, format: :short) %></time></dd></div>
                </dl>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="section-empty">Nenhum convite encerrado.</p>
        <% end %>
        <% if @sent_terminal_page.total_pages > 1 %>
          <nav class="pagination" aria-label="Paginação dos convites enviados encerrados">
            <% if @sent_terminal_page.number > 1 %><%= link_to "Anterior", group_settings_path(@group, pending_page: @sent_pending_page.number, closed_page: @sent_terminal_page.number - 1, anchor: "closed-invitations-history") %><% end %>
            <span>Página <%= @sent_terminal_page.number %> de <%= @sent_terminal_page.total_pages %></span>
            <% if @sent_terminal_page.number < @sent_terminal_page.total_pages %><%= link_to "Próxima", group_settings_path(@group, pending_page: @sent_pending_page.number, closed_page: @sent_terminal_page.number + 1, anchor: "closed-invitations-history") %><% end %>
          </nav>
        <% end %>
      </details>
    </section>
  <% end %>

  <section class="settings-section" aria-labelledby="members-title">
    <h2 id="members-title">Membros</h2>
    <ul class="settings-record-list">
      <% @memberships.each do |membership| %>
        <% deactivation_reason = @membership_deactivation_reasons.fetch(membership.id, nil) if policy(membership).deactivate? && membership.active? %>
        <li class="settings-record settings-member">
          <dl class="settings-record__fields">
            <div><dt>Nome</dt><dd><%= membership.user.name %></dd></div>
            <div><dt>E-mail</dt><dd><%= membership.user.email %></dd></div>
            <div><dt>Papel</dt><dd><%= render StatusBadgeComponent.new(status: membership.role) %></dd></div>
            <div><dt>Estado</dt><dd><%= render StatusBadgeComponent.new(status: (membership.active? ? :active : :inactive)) %></dd></div>
          </dl>
          <% unless @group.archived_at? %>
            <div class="settings-record__actions">
              <% if policy(membership).reactivate? && membership.inactive? %>
                <%= button_to "Reativar", "/groups/#{@group.id}/memberships/#{membership.id}/reactivate", class: "ui-button ui-button--secondary ui-button--compact" %>
              <% end %>
              <% if policy(membership).transfer_ownership? && membership.active? && membership.user_id != current_user.id %>
                <%= button_to "Transferir responsabilidade", "/groups/#{@group.id}/memberships/#{membership.id}/transfer_ownership", class: "ui-button ui-button--secondary ui-button--compact", data: { turbo_confirm: "Transferir a responsabilidade para #{membership.user.name}?" } %>
              <% end %>
              <% if policy(membership).deactivate? && membership.active? %>
                <% if deactivation_reason %>
                  <%= button_tag(membership.user_id == current_user.id ? "Sair do grupo" : "Inativar membro", type: "button", disabled: true, aria: { describedby: "membership_#{membership.id}_reason" }, class: "ui-button ui-button--secondary ui-button--compact") %>
                <% else %>
                  <%= button_to membership.user_id == current_user.id ? "Sair do grupo" : "Inativar membro", "/groups/#{@group.id}/memberships/#{membership.id}/deactivate", class: "ui-button ui-button--secondary ui-button--compact", data: { turbo_confirm: membership.user_id == current_user.id ? "Sair deste grupo?" : "Inativar #{membership.user.name}?" } %>
                <% end %>
              <% end %>
            </div>
          <% end %>
          <% if deactivation_reason %>
            <span id="membership_<%= membership.id %>_reason" class="settings-record__feedback"><%= deactivation_reason == "último owner ativo não pode sair" ? "Transfira a responsabilidade antes de sair." : deactivation_reason %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <% if policy(@group).update? && @memberships.active.many? %>
    <details class="settings-section settings-history">
      <summary>Administração avançada</summary>
      <section class="settings-subsection" aria-labelledby="member-order-title">
        <h2 id="member-order-title">Ordenar membros</h2>
        <p>Escolha um membro para cada posição e salve a ordem completa.</p>
        <%= form_with url: group_memberships_order_path(@group), scope: :membership, method: :patch, class: "settings-order-form" do |form| %>
          <% @memberships.select(&:active?).each_with_index do |membership, index| %>
            <div>
              <%= form.label "ids_#{index}", "Posição #{index + 1}" %>
              <%= select_tag "membership[ids][]", options_for_select(@memberships.select(&:active?).map { |candidate| ["#{candidate.user.name} (#{candidate.user.email})", candidate.id] }, membership.id), id: "membership_ids_#{index}", class: "ui-field__control" %>
            </div>
          <% end %>
          <%= form.submit "Salvar ordem", class: "ui-button ui-button--primary" %>
        <% end %>
      </section>
    </details>
  <% end %>

  <% if policy(@group).update? %>
    <section class="settings-section" aria-labelledby="archive-title">
      <h2 id="archive-title">Arquivamento</h2>
      <div class="settings-record__actions">
        <% if @group.archived_at? %>
          <%= button_to "Restaurar grupo", group_restore_path(@group), method: :post, class: "ui-button ui-button--primary" %>
        <% elsif @archive_reason %>
          <div class="settings-blocked-action">
            <%= button_tag "Arquivar grupo", type: "button", disabled: true, aria: { describedby: "archive_reason" }, class: "ui-button ui-button--secondary ui-button--compact" %>
            <span id="archive_reason" class="settings-action-note"><%= @archive_reason %></span>
          </div>
        <% else %>
          <%= button_to "Arquivar grupo", group_archive_path(@group), method: :post, class: "ui-button ui-button--secondary ui-button--compact", data: { turbo_confirm: "Arquivar este grupo?" } %>
        <% end %>
      </div>
    </section>
  <% end %>
</section>
