<section class="group-settings-page" aria-labelledby="settings-title">
  <%= render "groups/navigation", group: @group %>
  <header class="ui-page-header"><div><p class="eyebrow"><%= @group.name %></p><h1 id="settings-title" class="ui-page-header__title">Configurações</h1><p class="ui-page-header__description">Membros, convites, ownership e arquivamento seguem as permissões existentes do grupo.</p></div></header>
  <section class="settings-section" aria-labelledby="members-title"><h2 id="members-title">Membros</h2><ul class="audit-list"><% @memberships.each do |membership| %><li><strong><%= membership.user.email %></strong> <%= membership.role == "owner" ? "Owner" : "Membro" %>; <%= membership.active? ? "ativo" : "inativo" %>.</li><% end %></ul></section>
  <% if policy(@group).update? %><section class="settings-section" aria-labelledby="group-name-title"><h2 id="group-name-title">Nome do grupo</h2><%= form_with model: @group, class: "group-create__form" do |form| %><%= form.label :name, "Nome", class: "sr-only" %><%= form.text_field :name, required: true, class: "ui-field__control" %><%= form.submit "Salvar nome", class: "ui-button ui-button--primary" %><% end %></section><% end %>
  <% if policy(@group).update? %><section class="settings-section" aria-labelledby="archive-title"><h2 id="archive-title">Arquivamento</h2><% if @group.archived_at? %><%= button_to "Restaurar grupo", group_restore_path(@group), method: :post, class: "ui-button ui-button--primary" %><% else %><%= button_to "Arquivar grupo", group_archive_path(@group), method: :post, class: "ui-button ui-button--secondary", data: { turbo_confirm: "Arquivar este grupo?" } %><% end %></section><% end %>
</section>
