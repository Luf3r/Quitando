<% summary = local_assigns.fetch(:summary) { GroupOverviewPresenter.new(snapshot: dashboard, viewer_id: current_user.id, archived: group.archived_at?) } %>
<section id="group_dashboard_financial_summary" class="group-summary" aria-labelledby="resumo-financeiro">
  <h2 id="resumo-financeiro">Sua situação</h2>
  <dl class="group-summary__metrics">
    <div><dt>Estado</dt><dd><%= render StatusBadgeComponent.new(status: dashboard.status) %></dd></div>
    <div><dt>Saldo oficial</dt><dd><%= render MoneyComponent.new(cents: summary.viewer_official_cents, currency_code: group.currency_code) %></dd></div>
    <% if summary.show_viewer_projection? %><div><dt>Saldo projetado</dt><dd><%= render MoneyComponent.new(cents: summary.viewer_projected_cents, currency_code: group.currency_code) %></dd></div><% end %>
  </dl>

  <section id="group_next_action" aria-labelledby="next-action-title">
    <h3 id="next-action-title">Próxima ação</h3>
    <% if summary.primary_action == :review_received %>
      <% payment = summary.personal_pending.first.payment %><p>Revise o pagamento recebido antes de ele alterar o saldo oficial.</p><%= link_to "Revisar pagamento", group_payment_path(group, payment), class: "ui-button ui-button--secondary ui-button--compact" %>
    <% elsif summary.primary_action == :follow_sent %>
      <% payment = summary.waiting_pending.find { |item| item.direction == :sent }.payment %><p>Você marcou um pagamento como enviado. A confirmação ainda não alterou o saldo oficial.</p><%= link_to "Acompanhar pagamento", group_payment_path(group, payment), class: "ui-button ui-button--secondary ui-button--compact" %>
    <% elsif summary.primary_action == :report_transfer %>
      <% transfer = summary.viewer_transfer %><p>Você precisa enviar <%= render MoneyComponent.new(cents: transfer.amount_cents, currency_code: group.currency_code) %> para <%= dashboard.participant_names.fetch(transfer.to_user_id) %>.</p><%= link_to "Marcar como enviado", new_group_payment_path(group, to_user_id: transfer.to_user_id), data: { turbo_frame: "group_dialog" }, class: "ui-button ui-button--primary" %>
    <% elsif summary.primary_action == :add_expense %>
      <p>Este grupo ainda não tem despesas. Adicione a primeira para começar.</p><%= link_to "Adicionar despesa", new_group_expense_path(group), data: { turbo_frame: "group_dialog" }, class: "ui-button ui-button--secondary ui-button--compact" %>
    <% elsif summary.primary_action == :wait_for_others %>
      <p>Você está aguardando outras pessoas agirem.</p>
    <% elsif summary.primary_action == :settled %>
      <p>O grupo está quitado.</p>
    <% else %>
      <p>O grupo está arquivado e permanece disponível para consulta.</p>
    <% end %>
  </section>

  <% if !group.archived_at? && summary.primary_action != :add_expense %>
    <p><%= link_to "Adicionar despesa", new_group_expense_path(group), data: { turbo_frame: "group_dialog" }, class: "ui-button ui-button--secondary ui-button--compact" %></p>
  <% end %>

  <% if summary.primary_action == :report_transfer %>
    <% transfer = summary.viewer_transfer %>
    <nav id="group_mobile_actions" class="group-mobile-actions" aria-label="Ações do grupo">
      <%= link_to "Marcar como enviado", new_group_payment_path(group, to_user_id: transfer.to_user_id), data: { turbo_frame: "group_dialog" }, class: "ui-button ui-button--primary" %>
    </nav>
  <% elsif summary.primary_action == :add_expense %>
    <nav id="group_mobile_actions" class="group-mobile-actions" aria-label="Ações do grupo">
      <%= link_to "Adicionar despesa", new_group_expense_path(group), data: { turbo_frame: "group_dialog" }, class: "ui-button ui-button--secondary ui-button--compact" %>
    </nav>
  <% end %>

  <% if summary.personal_pending.any? %><section aria-labelledby="review-pending-title"><h3 id="review-pending-title">Você precisa revisar</h3><ul class="operational-list"><% summary.personal_pending.each do |item| %><li><span><strong><%= item.payment.from_user.name %></strong> reportou</span><span class="amount"><%= render MoneyComponent.new(cents: item.payment.amount_cents, currency_code: group.currency_code) %></span><%= link_to "Revisar pagamento", group_payment_path(group, item.payment), class: "ui-button ui-button--secondary ui-button--compact action" %></li><% end %></ul></section><% end %>
  <% if summary.waiting_pending.any? %><section aria-labelledby="waiting-pending-title"><h3 id="waiting-pending-title">Aguardando outra pessoa</h3><ul class="operational-list"><% summary.waiting_pending.each do |item| %><li><span><span class="operational-list__parties"><strong><%= item.payment.from_user.name %></strong><span class="operational-list__connector"> para </span><strong><%= item.payment.to_user.name %></strong></span><% if item.direction == :sent %><span class="operational-list__status">Aguarda confirmação</span><% end %></span><span class="amount"><%= render MoneyComponent.new(cents: item.payment.amount_cents, currency_code: group.currency_code) %></span></li><% end %></ul></section><% end %>

  <section aria-labelledby="participants-title"><h3 id="participants-title">Participantes</h3><dl class="participant-balances"><% summary.participants.each do |participant| %><div><dt><%= participant.name %></dt><dd><span>Oficial</span><strong><%= render MoneyComponent.new(cents: participant.official_cents, currency_code: group.currency_code) %></strong><% if participant.show_projection %><span>Projetado</span><strong><%= render MoneyComponent.new(cents: participant.projected_cents, currency_code: group.currency_code) %></strong><% end %></dd></div><% end %></dl></section>
</section>
