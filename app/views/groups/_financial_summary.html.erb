<% summary = local_assigns.fetch(:summary) { GroupOverviewPresenter.new(snapshot: dashboard, viewer_id: current_user.id, archived: group.archived_at?) } %>
<section id="group_dashboard_financial_summary" class="plan-section" aria-labelledby="resumo-financeiro">
  <h2 id="resumo-financeiro">Sua situação</h2>
  <p><%= render StatusBadgeComponent.new(status: dashboard.status) %></p>
  <p class="group-summary__balance">Saldo oficial: <strong><%= render MoneyComponent.new(cents: summary.viewer_official_cents, currency_code: group.currency_code) %></strong></p>
  <% if summary.show_viewer_projection? %><p>Saldo projetado, se as pendências forem confirmadas: <strong><%= render MoneyComponent.new(cents: summary.viewer_projected_cents, currency_code: group.currency_code) %></strong></p><% end %>

  <section id="group_next_action" aria-labelledby="next-action-title">
    <h3 id="next-action-title">Próxima ação</h3>
    <% if summary.primary_action == :review_received %>
      <% payment = summary.personal_pending.first.payment %><p>Revise o pagamento recebido antes de ele alterar o saldo oficial.</p><%= link_to "Revisar pagamento", group_payment_path(group, payment), class: "ui-button ui-button--primary" %>
    <% elsif summary.primary_action == :follow_sent %>
      <% payment = summary.waiting_pending.find { |item| item.direction == :sent }.payment %><p>Você marcou um pagamento como enviado. A confirmação ainda não alterou o saldo oficial.</p><%= link_to "Acompanhar pagamento", group_payment_path(group, payment), class: "ui-button ui-button--secondary" %>
    <% elsif summary.primary_action == :report_transfer %>
      <% transfer = summary.viewer_transfer %><p>Você precisa enviar <%= render MoneyComponent.new(cents: transfer.amount_cents, currency_code: group.currency_code) %> para <%= dashboard.participant_emails.fetch(transfer.to_user_id) %>.</p><%= link_to "Marcar como enviado", new_group_payment_path(group, to_user_id: transfer.to_user_id), data: { turbo_frame: "group_dialog" }, class: "ui-button ui-button--primary" %>
    <% elsif summary.primary_action == :add_expense %>
      <p>Este grupo ainda não tem despesas. Adicione a primeira para começar.</p><%= link_to "Adicionar despesa", new_group_expense_path(group), data: { turbo_frame: "group_dialog" }, class: "ui-button ui-button--primary" %>
    <% elsif summary.primary_action == :wait_for_others %>
      <p>Você está aguardando outras pessoas agirem.</p>
    <% elsif summary.primary_action == :settled %>
      <p>O grupo está quitado.</p>
    <% else %>
      <p>O grupo está arquivado e permanece disponível para consulta.</p>
    <% end %>
  </section>

  <% if !group.archived_at? && summary.primary_action != :add_expense %>
    <p><%= link_to "Adicionar despesa", new_group_expense_path(group), data: { turbo_frame: "group_dialog" } %></p>
  <% end %>

  <% if summary.primary_action == :report_transfer %>
    <% transfer = summary.viewer_transfer %>
    <nav id="group_mobile_actions" class="group-mobile-actions" aria-label="Ações do grupo">
      <%= link_to "Marcar como enviado", new_group_payment_path(group, to_user_id: transfer.to_user_id), data: { turbo_frame: "group_dialog" }, class: "ui-button ui-button--primary" %>
    </nav>
  <% elsif summary.primary_action == :add_expense %>
    <nav id="group_mobile_actions" class="group-mobile-actions" aria-label="Ações do grupo">
      <%= link_to "Adicionar despesa", new_group_expense_path(group), data: { turbo_frame: "group_dialog" }, class: "ui-button ui-button--primary" %>
    </nav>
  <% end %>

  <% if summary.personal_pending.any? %><section aria-labelledby="review-pending-title"><h3 id="review-pending-title">Você precisa revisar</h3><ul class="audit-list"><% summary.personal_pending.each do |item| %><li><%= item.payment.from_user.email %> reportou <%= render MoneyComponent.new(cents: item.payment.amount_cents, currency_code: group.currency_code) %>. <%= link_to "Revisar", group_payment_path(group, item.payment) %></li><% end %></ul></section><% end %>
  <% if summary.waiting_pending.any? %><section aria-labelledby="waiting-pending-title"><h3 id="waiting-pending-title">Aguardando outra pessoa</h3><ul class="audit-list"><% summary.waiting_pending.each do |item| %><li><%= item.payment.from_user.email %> reportou <%= render MoneyComponent.new(cents: item.payment.amount_cents, currency_code: group.currency_code) %> para <%= item.payment.to_user.email %>.<% if item.direction == :sent %> Você aguarda a confirmação.<% end %></li><% end %></ul></section><% end %>

  <section aria-labelledby="participants-title"><h3 id="participants-title">Participantes</h3><ul class="audit-list"><% summary.participants.each do |participant| %><li><strong><%= participant.email %></strong>. Saldo oficial: <%= render MoneyComponent.new(cents: participant.official_cents, currency_code: group.currency_code) %>.<% if participant.show_projection %> Projetado: <%= render MoneyComponent.new(cents: participant.projected_cents, currency_code: group.currency_code) %>.<% end %></li><% end %></ul></section>
</section>
