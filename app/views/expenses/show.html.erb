<div class="space-y-4">
  <%= link_to "Voltar ao grupo", group_path(@expense.group), class: "text-sm underline" %>
  <h1 class="text-2xl font-semibold"><%= @expense.description %></h1>
  <p><%= render MoneyComponent.new(cents: @expense.amount_cents, currency_code: @expense.group.currency_code) %></p>
  <p>pago por <%= @expense.paid_by_user.email %>, registrado por <%= @expense.created_by_user.email %></p>
  <h2 class="text-lg font-medium">Divisão</h2>
  <ul><% @expense.expense_shares.each do |share| %><li><%= share.user.email %>: <%= render MoneyComponent.new(cents: share.amount_owed_cents, currency_code: @expense.group.currency_code) %></li><% end %></ul>
  <% if @expense.replaces_expense %>
    <p>Esta despesa substitui <%= @expense.replaces_expense.description %>.</p>
  <% end %>
  <% if @expense.replacement_expenses.any? %>
    <p>Esta despesa foi anulada e substituída por <%= @expense.replacement_expenses.first.description %>.</p>
  <% end %>

  <% if policy(@expense).update_description? %>
    <section aria-labelledby="editar-descricao" class="mt-6">
      <h2 id="editar-descricao" class="text-lg font-medium">Editar descrição</h2>
      <%= form_with url: "/groups/#{@expense.group_id}/expenses/#{@expense.id}/description", scope: :expense, method: :patch, local: true, data: { turbo: false }, class: "mt-3 flex max-w-md gap-2" do |form| %>
        <%= form.label :description, "Descrição", class: "sr-only" %>
        <%= form.text_field :description, value: @expense.description, required: true, class: "min-w-0 flex-1 rounded border-slate-300" %>
        <%= form.submit "Salvar descrição", class: "rounded bg-slate-900 px-4 py-2 text-white" %>
      <% end %>
    </section>
  <% end %>

  <% if policy(@expense).correct? && !@expense.voided_at? %>
    <% correction = @correction_form %>
    <section aria-labelledby="corrigir-despesa" class="mt-6">
      <h2 id="corrigir-despesa" class="text-lg font-medium">Corrigir despesa</h2>
      <p>Uma correção anula esta despesa e registra uma substituta.</p>
      <%= form_with url: "/groups/#{@expense.group_id}/expenses/#{@expense.id}/correct", scope: :correction, local: true, data: { turbo: false }, class: "mt-3 space-y-3" do |form| %>
        <div><%= form.label :reason, "Motivo" %><%= form.text_field :reason, value: correction&.reason, required: true, class: "block w-full rounded border-slate-300" %></div>
        <div><%= form.label :description, "Descrição" %><%= form.text_field :description, value: correction&.description || @expense.description, required: true, class: "block w-full rounded border-slate-300" %></div>
        <div><%= form.label :amount_text, "Valor (R$)" %><%= form.text_field :amount_text, value: correction&.amount_text || MoneyFormatter.call(cents: @expense.amount_cents, currency_code: @expense.group.currency_code).delete_prefix("R$ "), required: true, inputmode: "decimal", class: "block rounded border-slate-300" %></div>
        <div><%= form.label :paid_by_user_id, "Pago por" %><%= form.select :paid_by_user_id, @expense.group.memberships.active.includes(:user).order(:position).map { |membership| [ membership.user.email, membership.user_id ] }, { selected: correction&.paid_by_user_id || @expense.paid_by_user_id }, class: "rounded border-slate-300" %></div>
        <%= form.hidden_field :split_type, value: "equal" %>
        <% @expense.group.memberships.active.order(:position).each do |membership| %>
          <%= hidden_field_tag "correction[participant_user_ids][]", membership.user_id %>
        <% end %>
        <%= form.hidden_field :expected_financial_state_version, value: @current_financial_state_version || @expense.group.financial_state_version %>
        <%= form.hidden_field :idempotency_key, value: correction&.idempotency_key || SecureRandom.uuid %>
        <%= form.submit "Registrar correção", class: "rounded bg-slate-900 px-4 py-2 text-white" %>
      <% end %>
      <% if @dashboard %><p class="mt-3">Plano líquido: a sugestão atual compensa os saldos do grupo e reduz transferências.</p><% end %>
    </section>
  <% end %>
</div>
