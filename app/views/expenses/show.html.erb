<%= render "groups/realtime_shell", group: @expense.group %>

<section class="financial-detail-page expense-detail" aria-labelledby="expense-title">
  <%= link_to "Voltar ao grupo", group_path(@expense.group), class: "back-link" %>

  <header class="financial-detail__header">
    <div class="financial-detail__title-row">
      <div>
        <p class="financial-detail__eyebrow"><%= @expense.group.name %></p>
        <h1 id="expense-title"><%= @expense.description %></h1>
      </div>
      <%= render StatusBadgeComponent.new(status: (@expense.voided_at? ? :voided : :active), label: (@expense.voided_at? ? "Anulada" : "Ativa")) %>
    </div>
    <p class="financial-detail__amount"><span class="sr-only">Valor</span><%= render MoneyComponent.new(cents: @expense.amount_cents, currency_code: @expense.group.currency_code) %></p>
  </header>

  <dl class="financial-detail__metadata">
    <div data-expense-field="date"><dt>Data</dt><dd><time datetime="<%= @expense.occurred_on.iso8601 %>"><%= l(@expense.occurred_on) %></time></dd></div>
    <div data-expense-field="paid-by"><dt>Pago por</dt><dd><%= @expense.paid_by_user.name %></dd></div>
    <div data-expense-field="created-by"><dt>Registrado por</dt><dd><%= @expense.created_by_user.name %></dd></div>
    <% if @expense.voided_at? %>
      <div data-expense-field="voided-by"><dt>Anulada por</dt><dd><%= @expense.voided_by_user.name %></dd></div>
      <div data-expense-field="voided-at"><dt>Anulada em</dt><dd><time datetime="<%= @expense.voided_at.iso8601 %>"><%= l(@expense.voided_at, format: :short) %></time></dd></div>
      <div class="financial-detail__metadata-wide" data-expense-field="void-reason"><dt>Motivo</dt><dd><%= @expense.void_reason %></dd></div>
    <% end %>
  </dl>

  <section class="financial-detail__section" aria-labelledby="expense-shares-title">
    <h2 id="expense-shares-title">Divisão</h2>
    <ul class="expense-share-list">
      <% @expense.expense_shares.each do |share| %>
        <li><span><%= share.user.name %></span><strong><%= render MoneyComponent.new(cents: share.amount_owed_cents, currency_code: @expense.group.currency_code) %></strong></li>
      <% end %>
    </ul>
  </section>

  <% if @expense.replaces_expense || @expense.replacement_expenses.any? %>
    <section class="financial-detail__section expense-relations" aria-labelledby="expense-relations-title">
      <h2 id="expense-relations-title">Histórico de correção</h2>
      <% if @expense.replaces_expense %>
        <p data-expense-relation="replaces"><span>Esta despesa substitui</span> <%= link_to @expense.replaces_expense.description, group_expense_path(@expense.group, @expense.replaces_expense) %></p>
      <% end %>
      <% @expense.replacement_expenses.each do |replacement| %>
        <p data-expense-relation="replaced-by"><span>Esta despesa foi anulada e substituída por</span> <%= link_to replacement.description, group_expense_path(@expense.group, replacement) %></p>
      <% end %>
    </section>
  <% end %>

  <% if @expense.expense_description_revisions.any? %>
    <section class="financial-detail__section" aria-labelledby="revisoes-descricao">
      <h2 id="revisoes-descricao">Revisões de descrição</h2>
      <ul class="expense-revision-list">
        <% @expense.expense_description_revisions.order(:created_at, :id).each do |revision| %>
          <li><strong><%= revision.actor_user.name %></strong><span>alterou de “<%= revision.previous_description %>” para “<%= revision.new_description %>”</span><time datetime="<%= revision.created_at.iso8601 %>"><%= l(revision.created_at, format: :short) %></time></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if policy(@expense).update_description? && !@expense.group.archived_at? %>
    <section aria-labelledby="editar-descricao" class="financial-detail__section expense-edit-region">
      <h2 id="editar-descricao">Editar descrição</h2>
      <%= form_with url: "/groups/#{@expense.group_id}/expenses/#{@expense.id}/description", scope: :expense, method: :patch, local: true, data: { turbo: false }, class: "expense-description-form" do |form| %>
        <%= render FieldComponent.new(label: "Descrição", name: "expense[description]", value: @expense.description, options: { required: true }) %>
        <%= form.submit "Salvar descrição", class: "ui-button ui-button--primary" %>
      <% end %>
    </section>
  <% end %>

  <% if policy(@expense).correct? && !@expense.voided_at? && !@expense.group.archived_at? %>
    <section aria-labelledby="corrigir-despesa" class="financial-detail__section expense-correction-region">
      <h2 id="corrigir-despesa">Corrigir despesa</h2>
      <p>Uma correção anula esta despesa e registra uma substituta na mesma operação.</p>
      <%= link_to "Corrigir despesa", group_expense_correction_path(@expense.group, @expense), data: { turbo_frame: "group_dialog" }, class: "ui-button ui-button--secondary ui-button--compact" %>
    </section>
  <% end %>
</section>
