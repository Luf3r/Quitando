<% memberships = dashboard.memberships %>
<% equal_participants = expense_form&.split_type == "equal" ? expense_form.participant_user_ids : memberships.map(&:user_id) %>
<% exact_shares = expense_form&.shares&.index_by { |share| share[:user_id].to_s } || {} %>

<%= form_with url: group_expenses_preview_path(group), scope: :expense, class: "expense-entry-form", data: { turbo_frame: "expense_preview" } do |form| %>
  <div><%= form.label :description, "Descrição" %><%= form.text_field :description, value: expense_form&.description, required: true, class: "block w-full rounded border-slate-300" %></div>
  <div><%= form.label :occurred_on, "Data" %><%= form.date_field :occurred_on, value: expense_form&.occurred_on.presence || Date.current.iso8601, required: true, class: "block rounded border-slate-300" %></div>
  <div><%= form.label :amount_text, "Valor (R$)" %><%= form.text_field :amount_text, value: expense_form&.amount_text, required: true, inputmode: "decimal", class: "block rounded border-slate-300" %></div>
  <div><%= form.label :paid_by_user_id, "Pago por" %><%= form.select :paid_by_user_id, memberships.map { |membership| [ membership.user.email, membership.user_id ] }, { selected: expense_form&.paid_by_user_id }, class: "rounded border-slate-300" %></div>
  <fieldset><legend>Como dividir</legend>
    <label><%= radio_button_tag "expense[split_type]", "equal", expense_form&.split_type != "exact" %> Dividir igualmente</label>
    <label><%= radio_button_tag "expense[split_type]", "exact", expense_form&.split_type == "exact" %> Informar valores exatos</label>
  </fieldset>
  <fieldset><legend>Participantes da divisão igual</legend><% memberships.each do |membership| %><label class="block"><%= check_box_tag "expense[participant_user_ids][]", membership.user_id, equal_participants.include?(membership.user_id) %> <%= membership.user.email %></label><% end %></fieldset>
  <fieldset><legend>Valores exatos</legend><% memberships.each_with_index do |membership, index| %><label class="block"><%= membership.user.email %><%= hidden_field_tag "expense[shares][#{index}][user_id]", membership.user_id %><%= text_field_tag "expense[shares][#{index}][amount_text]", exact_shares[membership.user_id.to_s]&.fetch(:amount_text, nil), inputmode: "decimal", class: "ml-2 rounded border-slate-300" %></label><% end %></fieldset>
  <%= form.submit "Revisar divisão", class: "ui-button ui-button--primary" %>
<% end %>

<turbo-frame id="expense_preview"></turbo-frame>
