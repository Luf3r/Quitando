<section class="space-y-6" aria-labelledby="invitations-title">
  <h1 id="invitations-title" class="text-2xl font-semibold">Convites</h1>

  <section aria-labelledby="pending-invitations-title">
    <h2 id="pending-invitations-title" class="text-xl font-semibold">Pendentes</h2>
    <% if @pending_page.entries.any? %>
      <ul class="mt-3 space-y-3">
        <% @pending_page.entries.each do |invitation| %>
          <li class="rounded border border-slate-200 bg-white p-4">
            <p><strong><%= invitation.group.name %></strong></p>
            <p class="text-sm text-slate-600">Convidado por <%= invitation.invited_by_user.email %>. <%= invitation_status_label(invitation.status) %> em <time datetime="<%= invitation.created_at.iso8601 %>"><%= l(invitation.created_at, format: :short) %></time>.</p>
            <div class="mt-3 flex gap-2">
              <%= button_to "Aceitar convite", "/invitations/#{invitation.id}/accept", method: :post, form: { data: { turbo_stream: true } }, class: "rounded bg-slate-900 px-3 py-2 text-white" %>
              <%= button_to "Recusar convite", "/invitations/#{invitation.id}/decline", method: :post, form: { data: { turbo_stream: true } }, class: "rounded border border-slate-300 px-3 py-2" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3">Você não possui convites pendentes.</p>
    <% end %>
    <% if @pending_page.total_pages > 1 %><nav class="pagination" aria-label="Paginação dos convites pendentes"><% if @pending_page.number > 1 %><%= link_to "Anterior", invitations_path(page: @pending_page.number - 1) %><% end %><span>Página <%= @pending_page.number %> de <%= @pending_page.total_pages %></span><% if @pending_page.number < @pending_page.total_pages %><%= link_to "Próxima", invitations_path(page: @pending_page.number + 1) %><% end %></nav><% end %>
  </section>

  <section aria-labelledby="terminal-invitations-title">
    <h2 id="terminal-invitations-title" class="text-xl font-semibold">Encerrados</h2>
    <% if @terminal_page.entries.any? %>
      <ul class="mt-3 space-y-3">
        <% @terminal_page.entries.each do |invitation| %>
          <% terminal_at = invitation_terminal_at(invitation) %>
          <li class="rounded border border-slate-200 bg-white p-4">
            <p><strong><%= invitation.group.name %></strong></p>
            <p class="text-sm text-slate-600">Convidado por <%= invitation.invited_by_user.email %>. <%= invitation_status_label(invitation.status) %> em <time datetime="<%= terminal_at.iso8601 %>"><%= l(terminal_at, format: :short) %></time>.</p>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3">Você não possui convites encerrados.</p>
    <% end %>
    <% if @terminal_page.total_pages > 1 %><nav class="pagination" aria-label="Paginação dos convites encerrados"><% if @terminal_page.number > 1 %><%= link_to "Anterior", invitations_path(page: @terminal_page.number - 1) %><% end %><span>Página <%= @terminal_page.number %> de <%= @terminal_page.total_pages %></span><% if @terminal_page.number < @terminal_page.total_pages %><%= link_to "Próxima", invitations_path(page: @terminal_page.number + 1) %><% end %></nav><% end %>
  </section>
</section>
