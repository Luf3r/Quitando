<div class="space-y-6">
  <h1 class="text-2xl font-semibold">Convites</h1>
  <% if @invitations.any? %>
    <ul class="space-y-3">
      <% @invitations.each do |invitation| %>
        <li class="rounded border border-slate-200 bg-white p-4">
          <p><%= invitation.group.name %></p>
          <p class="text-sm text-slate-600">Convidado por <%= invitation.invited_by_user.email %></p>
          <div class="mt-3 flex gap-2">
            <%= button_to "Aceitar convite", "/invitations/#{invitation.id}/accept", method: :post, data: { turbo: false }, class: "rounded bg-slate-900 px-3 py-2 text-white" %>
            <%= button_to "Recusar convite", "/invitations/#{invitation.id}/decline", method: :post, data: { turbo: false }, class: "rounded border border-slate-300 px-3 py-2" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>Você não possui convites pendentes.</p>
  <% end %>
</div>
