<section class="auth-page" aria-labelledby="session-title">
  <div class="auth-page__intro">
    <p class="eyebrow">Bem-vindo de volta</p>
    <h1 id="session-title">Entrar no Quitando</h1>
    <p>Retome seu grupo exatamente do ponto em que as contas ficaram.</p>
  </div>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |form| %>
    <%= render FormErrorsComponent.new(messages: resource.errors.full_messages) if resource.errors.any? %>
    <div class="ui-field">
      <%= form.label :email, "E-mail", class: "ui-field__label" %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "ui-field__control" %>
    </div>
    <div class="ui-field">
      <%= form.label :password, "Senha", class: "ui-field__label" %>
      <%= form.password_field :password, autocomplete: "current-password", class: "ui-field__control" %>
    </div>
    <% if devise_mapping.rememberable? %>
      <label class="auth-check"><%= form.check_box :remember_me %> Manter sessão neste dispositivo</label>
    <% end %>
    <%= form.submit "Entrar", class: "ui-button ui-button--primary" %>
  <% end %>
  <p class="auth-page__links"><%= link_to "Criar conta", new_registration_path(resource_name) %> <%= link_to "Esqueci minha senha", new_password_path(resource_name) %></p>
</section>
