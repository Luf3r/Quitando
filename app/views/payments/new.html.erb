<%= render "groups/realtime_shell", group: @group %>

<main class="mx-auto max-w-3xl space-y-4">
  <%= link_to "Voltar ao grupo", group_path(@group), class: "text-sm underline" %>
  <h1 class="text-2xl font-semibold">Registrar pagamento</h1>
  <% if @payment_error %><p role="alert" class="rounded border border-rose-300 bg-rose-50 p-3 text-rose-900"><%= @payment_error %></p><% end %>
  <%= render "payments/conflict_context", payment_conflict: @payment_conflict, dashboard: @dashboard %>
  <% if @payment_form %>
    <p><%= @dashboard.participant_emails.fetch(@payment_form.fetch(:from_user_id), "Participante indisponível") %> para <%= @dashboard.participant_emails.fetch(@payment_form.fetch(:to_user_id), "Participante indisponível") %>.</p>
    <%= render "payments/report_form", group: @group, payment_form: @payment_form %>
  <% end %>
  <% if @dashboard && (@payment_conflict || @payment_error) %><%= render "groups/financial_summary", group: @group, dashboard: @dashboard %><% end %>
</main>
