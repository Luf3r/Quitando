#!/bin/bash -e

# If running the Rails server, prepare the database unless the platform's
# release command already applied migrations.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1}" == "server" ] && [ "${QUITANDO_PREPARE_ON_BOOT:-true}" != "false" ]; then
  ./bin/rails db:prepare
  if [ "${QUITANDO_DEMO_MODE:-}" = "true" ]; then
    ./bin/rails db:seed
  fi
fi

exec "${@}"
