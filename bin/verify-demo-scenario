#!/usr/bin/env ruby

require "bundler/setup"
require "pg"
require "securerandom"
require "tempfile"
require "uri"
require_relative "../lib/financial_migration_command_runner"

PREFIX = "quitando_demo_verifier_".freeze
TIMEOUT_SECONDS = Integer(ENV.fetch("DEMO_SCENARIO_VERIFIER_TIMEOUT_SECONDS", "180"), 10)
TERMINATION_GRACE_SECONDS = Float(ENV.fetch("DEMO_SCENARIO_VERIFIER_TERMINATION_GRACE_SECONDS", "5"))

def fail!(message)
  warn message
  exit 1
end

def run!(*command, environment:)
  Tempfile.create("demo-scenario-stdout") do |stdout|
    Tempfile.create("demo-scenario-stderr") do |stderr|
      status = FinancialMigrationCommandRunner.new(
        timeout_seconds: TIMEOUT_SECONDS,
        termination_grace_seconds: TERMINATION_GRACE_SECONDS
      ).call(*command, environment:, out: stdout, err: stderr)
      stdout.flush
      stderr.flush
      stdout.rewind
      stderr.rewind
      output = stdout.read
      errors = stderr.read
      return output if status.success?

      fail!("#{command.join(" ")} failed:\n#{output}\n#{errors}")
    end
  end
rescue FinancialMigrationCommandRunner::CommandTimedOut => error
  fail!(error.message)
end

def database_url_for(uri, database)
  copy = uri.dup
  copy.path = "/#{database}"
  copy.to_s
end

def database_uri(raw_url)
  begin
    uri = URI.parse(raw_url)
    query_parameters = URI.decode_www_form(uri.query.to_s)
  rescue URI::InvalidURIError, ArgumentError
    raise ArgumentError, "TEST_DATABASE_URL is invalid", cause: nil
  end

  if query_parameters.any? { |key, _value| key == "dbname" }
    raise ArgumentError, "TEST_DATABASE_URL must not contain a dbname query parameter", cause: nil
  end

  unless %w[postgres postgresql].include?(uri.scheme) && uri.path&.match?(%r{\A/[^/]+\z})
    raise ArgumentError, "TEST_DATABASE_URL must be a PostgreSQL URL with a database name", cause: nil
  end

  uri
end

source_url = ENV.fetch("TEST_DATABASE_URL") { fail!("TEST_DATABASE_URL is required") }
begin
  source_uri = database_uri(source_url)
rescue ArgumentError => error
  fail!(error.message)
end
temporary_database = "#{PREFIX}#{SecureRandom.hex(8)}"
admin_url = database_url_for(source_uri, "postgres")
temporary_url = database_url_for(source_uri, temporary_database)
admin = PG.connect(admin_url)
created = false

begin
  admin.exec("CREATE DATABASE #{PG::Connection.quote_ident(temporary_database)}")
  created = true
  environment = {
    "RAILS_ENV" => "test",
    "DATABASE_URL" => temporary_url,
    "TEST_DATABASE_URL" => temporary_url,
    "QUITANDO_DEMO_MODE" => "true",
    "QUITANDO_DEMO_DATABASE_NAME" => temporary_database,
    "QUITANDO_DEMO_PASSWORD" => "senha-publica",
    "CONFIRM_DEMO_RESET" => "quitando-demo-only"
  }
  run!("bin/rails", "db:prepare", environment:)
  snapshot = run!("bin/rails", "runner", <<~RUBY, environment:).strip
    first = DemoScenario::Installer.call
    second = DemoScenario::Installer.call
    abort "installer was not idempotent" unless first.id == second.id
    puts [User.where(demo_account: true).count, Group.count, Expense.count, Payment.count, GroupInvitation.count, Membership.count, DemoScenario.count].join(":")
  RUBY
  fail!("canonical installation snapshot is malformed") unless snapshot == "4:6:37:7:18:19:1"
  financial_snapshot = run!("bin/rails", "runner", <<~RUBY, environment:).strip
    ana = User.find_by!(email: "ana@demo.quitando.test")
    bruno = User.find_by!(email: "bruno@demo.quitando.test")
    carla = User.find_by!(email: "carla@demo.quitando.test")
    diego = User.find_by!(email: "diego@demo.quitando.test")
    viagem = Group.find_by!(name: "Viagem para a serra")
    contas = Group.find_by!(name: "Contas do apartamento")
    official = GroupBalanceCalculator.call(viagem)
    projected = ProjectedBalanceCalculator.call(official, viagem.payments.reported)
    metrics = GroupDashboardQuery.call(group: contas, viewer: ana).visualization.metrics.map(&:count)
    values = [
      official.fetch(ana.id), official.fetch(bruno.id), official.fetch(carla.id), official.fetch(diego.id),
      projected.fetch(ana.id), projected.fetch(bruno.id), projected.fetch(carla.id), projected.fetch(diego.id),
      *metrics
    ]
    puts values.join(":")
  RUBY
  fail!("canonical financial scenario is malformed: #{financial_snapshot.inspect}") unless financial_snapshot == "124318:-80205:-97582:53469:26736:-50205:0:23469:8:6:3"
  after_reset = run!("bin/rails", "runner", <<~RUBY, environment:).strip
    ana = User.find_by!(email: "ana@demo.quitando.test")
    GroupCreator.call(owner_user_id: ana.id, name: "verifier mutation")
    DemoScenario::Resetter.call(manual: true)
    puts [User.where(demo_account: true).count, Group.count, Expense.count, Payment.count, GroupInvitation.count, Membership.count, DemoScenario.count, Group.where(name: "verifier mutation").count].join(":")
  RUBY
  fail!("reset did not restore canonical snapshot: #{after_reset.inspect}") unless after_reset == "4:6:37:7:18:19:1:0"
  run!("bin/rails", "runner", <<~RUBY, environment:)
    preserved = User.create!(email: "rollback-verifier@example.test", password: "password-123")
    begin
      DemoScenario::Resetter.new(config: DemoScenario::Config.new, installer: -> { raise "intentional reset failure" }).call(manual: true)
    rescue RuntimeError
    end
    abort "rollback failed" unless User.exists?(preserved.id)
    wrong = DemoScenario::Config.new(environment: ENV.to_h.merge("QUITANDO_DEMO_DATABASE_NAME" => "wrong"))
    begin
      DemoScenario::Resetter.call(config: wrong, manual: true)
      abort "unauthorised database accepted"
    rescue DemoScenario::Config::UnauthorizedDatabase
    end
  RUBY
  puts "demo scenario verifier passed"
ensure
  primary_error = $!
  cleanup_error = nil
  begin
    if created
      admin.exec_params("SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = $1 AND pid <> pg_backend_pid()", [ temporary_database ])
      admin.exec("DROP DATABASE #{PG::Connection.quote_ident(temporary_database)}")
    end
  rescue StandardError => error
    cleanup_error = error
    warn "demo scenario verifier cleanup failed: #{error.class}: #{error.message}"
  ensure
    begin
      admin.close if admin
    rescue StandardError => error
      cleanup_error ||= error
      warn "demo scenario verifier connection cleanup failed: #{error.class}: #{error.message}"
    end
  end
  raise cleanup_error if cleanup_error && !primary_error
end
